#!/bin/bash
# Smoke test: Qwen2-VL-7B on a few POPE samples, pruning off vs on.
# Submit FROM THE REPO ROOT (the job runs in the folder you submit from):
#   cd <your repo> && qsub cluster/smoke.pbs
# The log vlmp_smoke.o<jobid> appears in the repo root (ignored by .gitignore: *.o[0-9]*).
#PBS -N vlmp_smoke
#PBS -q shortGPUQ
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=H100
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -k oed
# -j oe : stdout + stderr (prints + errors) go into ONE log file: vlmp_smoke.o<jobid>
# -k oed: write that log straight into the submit dir while the job runs (tail -f works);
#         if the cluster rejects this option, delete the line: the log then appears at job end

set -e
cd "$PBS_O_WORKDIR"     # = the folder qsub was run from
[ -f cluster/smoke_test.py ] || { echo "Submit from the repo root (no cluster/smoke_test.py in $PWD)"; exit 1; }

source ~/miniconda3/etc/profile.d/conda.sh
conda activate vlmp
module load CUDA/12.4.0
export HF_HOME=$HOME/hf_cache HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1

echo "node: $(hostname) | repo: $PWD | commit: $(git rev-parse --short HEAD) | job: $PBS_JOBID"
nvidia-smi --query-gpu=name,memory.total,memory.used --format=csv

# extra options via: qsub -v SMOKE_ARGS="--n 10 --ratio 0.667" cluster/smoke.pbs
# -u = unbuffered: prints reach the log immediately, so nothing is lost if the job crashes or hits walltime
python -u cluster/smoke_test.py ${SMOKE_ARGS}
